---
import "../styles/global.css";

interface Frontmatter {
	title?: string;
	description?: string;
}

interface Props {
	title?: string;
	description?: string;
	frontmatter?: Frontmatter;
}

const { frontmatter, title: propTitle, description: propDescription } = Astro.props;
const title = propTitle ?? frontmatter?.title ?? "Satteri Links";
const description = propDescription ?? frontmatter?.description ?? "Build-time link previews for Sätteri Markdown.";
const pathname = Astro.url.pathname;
const links = [
	{ href: "/", label: "Home" },
	{ href: "/link-card/", label: "Link Card" },
	{ href: "/link-mention/", label: "Link Mention" },
];
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title === "Satteri Links" ? title : `${title} · Satteri Links`}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-title" href="/">Satteri Links</a>
			<nav class="site-nav" aria-label="Main navigation">
				{links.map((link) => (
					<a href={link.href} aria-current={pathname === link.href ? "page" : undefined}>
						{link.label}
					</a>
				))}
			</nav>
		</header>

		<main class="markdown-body">
			<slot />
		</main>

		<footer class="site-footer">
			<a href="https://github.com/ItoShimeji/satteri-links">GitHub repository</a>
		</footer>
	</body>
</html>
