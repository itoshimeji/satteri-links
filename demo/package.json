{
  "name": "satteri-links-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:workspace": "vp run --cache -t build",
    "build:cloudflare": "pnpm run build:workspace && cf-wrangler build",
    "preview": "astro preview",
    "deploy": "pnpm run build:cloudflare && cf deploy --prebuilt",
    "deploy:check": "pnpm run build:cloudflare && cf deploy --prebuilt --dry-run",
    "astro": "astro",
    "build:e2e": "node e2e/build.mjs",
    "test:e2e": "pnpm run build:e2e && playwright test",
    "preview:e2e": "astro preview --config astro.e2e.config.mjs --host 127.0.0.1 --port 4173 --ignore-lock"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "github-markdown-css": "^5.9.0",
    "satteri": "0.10.5",
    "satteri-heading-link": "workspace:*",
    "satteri-link-card": "workspace:*",
    "satteri-link-mention": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "cf": "1.0.0-beta.9",
    "vite-plus": "catalog:",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
