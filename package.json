{
  "name": "satteri-links",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "build": "vp run --cache -r build",
    "dev": "vp run -r --parallel dev",
    "test": "vp run --cache -r test",
    "check": "vp run --cache -r check",
    "release:card": "bumpp packages/link-card/package.json --no-push --commit \"chore: release satteri-link-card v%s\" --tag \"satteri-link-card-v%s\"",
    "release:mention": "bumpp packages/link-mention/package.json --no-push --commit \"chore: release satteri-link-mention v%s\" --tag \"satteri-link-mention-v%s\"",
    "release:preview": "bumpp packages/link-preview/package.json --no-push --commit \"chore: release @itoshinji/link-preview v%s\" --tag \"link-preview-v%s\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
