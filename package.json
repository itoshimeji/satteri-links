{
  "name": "satteri-links",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "build": "vp run --cache -r build",
    "dev": "vp run dev:workspace",
    "test": "vp run test:workspace",
    "check": "vp run check:workspace",
    "changeset": "changeset",
    "release:version": "changeset version && vp install --lockfile-only && vp fmt",
    "release:check": "node --test scripts/release.test.mjs scripts/release-pnpm.test.mjs scripts/resolve-release.test.mjs",
    "release:pack": "node scripts/verify-release-pack.mjs --pack",
    "test:e2e": "pnpm --filter satteri-links-demo test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
